library(readxl)
library(WGCNA)
library(dplyr)

# 1. 加载数据
file_path <- "E:/RESEARCH/meniscus/GSE286034_RAW/result/immuno_degs.xlsx"
# 读取 cluster4 所在的 Sheet
df_raw <- read_excel(file_path, sheet = "cluster4")

# 2. 筛选 p_val_adj 最小的前 20 个基因
# 假设列名是 p_val_adj，如果您的表格列名不同，请修改此处
df_top20 <- df_raw %>%
  arrange(p_val_adj) %>%      # 按 P 值从小到大排序
  head(20)                    # 取前 20 行

# 提取基因名称（假设第一列是基因名）
target_genes <- df_top20[[1]]
cat("选定的前20个显著基因是：\n", paste(target_genes, collapse = ", "), "\n")

# 3. 准备表达量矩阵
# 注意：hdWGCNA 需要这些基因在各个样本中的表达值
# 假设从第 2 列开始到最后一列是样本的表达量数据
datExpr <- as.data.frame(t(df_top20[, -1])) 
# 如果您的表格后面带有 logFC, p_val 等统计列，请确保 -1 修改为排除这些非表达量列的范围
# 例如：df_top20[, 2:21] 表示第2到21列是样本数据

colnames(datExpr) <- target_genes
rownames(datExpr) <- colnames(df_top20)[-1]

# 4. 计算邻接矩阵 (由于基因极少，这里 softPower 选 1 即可，或沿用常用值)
# 对于极少量基因，我们主要看它们的相关性强度
adjacency = adjacency(datExpr, power = 1, type = "unsigned")
TOM = TOMsimilarity(adjacency)

# 5. 导出 Cytoscape 文件
# 因为只有20个基因，threshold 可以设低一点（比如 0），展示所有可能的连接
exportNetworkToCytoscape(
  TOM,
  edgeFile = "cluster4_top20_edges.csv",
  nodeFile = "cluster4_top20_nodes.csv",
  weighted = TRUE,
  threshold = 0, 
  nodeNames = target_genes,
  altNodeNames = target_genes
)

