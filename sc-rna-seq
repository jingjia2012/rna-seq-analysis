library("clusterProfiler")
library("enrichplot")
library("colorspace")
library("ggforce")
library("DBI")
library("monocle")
library("org.Mm.eg.db")
library(BiocManager)
BiocManager::install("org.Hs.eg.db")

# --- 1. 设置参数 ---

excel_file <- "immuno_degs.xlsx" # 您的 Excel 文件名
sheets <- excel_sheets(excel_file)    # 获取所有 Sheet 名称
output_dir <- "./GO_Results/"         # 结果输出目录
if(!dir.exists(output_dir)) dir.create(output_dir)

# --- 2. 循环处理每个细胞群 ---
for (sheet_name in sheets) {
  message(paste("正在处理细胞群:", sheet_name))
  
  # 读取数据
  deg_data <- read_excel(excel_file, sheet = sheet_name)
  
  # 假设第一列是基因名，如果没有列名请手动重命名
  # 如果第一列已经是基因名，请确保列名为 'gene'
  colnames(deg_data)[1] <- "gene"
  
  # --- 3. 筛选差异基因 ---
  # 筛选标准：p_val_adj < 0.05 且 |avg_log2FC| > 0.5 (可根据需要调整)
  up_genes <- deg_data %>% 
    filter(p_val_adj < 0.05 & avg_log2FC > 0.5) %>% 
    pull(gene)
  
  down_genes <- deg_data %>% 
    filter(p_val_adj < 0.05 & avg_log2FC < -0.5) %>% 
    pull(gene)
  
  # 定义一个富集分析函数
  run_go <- function(genes, type, cluster) {
    # 1. 执行富集分析
    go_res <- enrichGO(gene          = genes,
                       OrgDb         = org.Mm.eg.db,
                       keyType       = "SYMBOL",
                       ont           = "ALL",
                       pAdjustMethod = "BH",
                       pvalueCutoff  = 0.05,
                       qvalueCutoff  = 0.2)
    
    # 2. 执行保存和绘图逻辑 (必须在 return 之前)
    if (!is.null(go_res) && nrow(as.data.frame(go_res)) > 0) {
      message(paste("Processing", cluster, type, "..."))
      
      # 保存表格
      write.csv(as.data.frame(go_res), 
                file = paste0(output_dir, cluster, "_", type, "_GO_table.csv"))
      
      # 绘制并保存气泡图
      p <- dotplot(go_res, showCategory = 15) + 
        ggtitle(paste(cluster, type, "GO Enrichment"))
      
      ggsave(filename = paste0(output_dir, cluster, "_", type, "_GO_dotplot.pdf"), 
             plot = p, width = 8, height = 7)
    } else {
      message(paste("No significant GO terms for", cluster, type))
    }
    
    # 3. 最后再返回结果
    return(go_res)
  
  }
  
  # 执行上调和下调基因的 GO 分析
  run_go(up_genes, "Up", sheet_name)
  run_go(down_genes, "Down", sheet_name)
}

 message("所有细胞群 GO 分析已完成！结果保存在 GO_Results 文件夹中。")

