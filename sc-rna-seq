head(modules) # 可以看到每个基因属于哪个颜色模块
hub_genes <- GetHubGenes(sci.combined, n_hubs = 10)
# 这会返回一个包含每个模块 Top 10 核心基因的表格
# 假设你的 hub_genes 已经是一个数据框
