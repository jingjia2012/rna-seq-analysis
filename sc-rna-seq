# 1. 提取所有基因之间的连接权重 (TOM)
# 确保你之前运行过 ConstructNetwork
TOM <- GetTOM(sci.combined) 

# 2. 筛选你关注的 Hub 基因
# 建议只选每个模块前 25-50 个基因，否则连线太多 Cytoscape 会卡死
target_genes <- hub_genes$gene_name
# 确保这些基因在矩阵中存在
target_genes <- intersect(target_genes, colnames(TOM))

# 3. 提取子矩阵并转换为边列表
sub_TOM <- TOM[target_genes, target_genes]

# 将矩阵转为长表格格式 (Source, Target, Weight)
edge_df <- as.data.frame(as.table(sub_TOM))
colnames(edge_df) <- c("from", "to", "weight")

# 4. 关键：过滤掉弱连接（非常重要，否则图会变成一团乱麻）
# 通常设置权重阈值在 0.1 到 0.2 之间
edge_df <- edge_df[edge_df$weight > 0.15 & edge_df$from != edge_df$to, ]

# 导出边文件
write.csv(edge_df, "Cytoscape_Edges_HubGenes-cluster4.csv", row.names = FALSE)
